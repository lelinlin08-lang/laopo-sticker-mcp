# Public origin of this deployed MCP service. No trailing slash.
# Local development default: http://127.0.0.1:8000
PUBLIC_BASE_URL=https://your-service.example.com

# Optional path overrides. Relative paths are resolved from the project root.
# Set this only if the server is launched outside the checked-out project directory.
# STICKER_PROJECT_ROOT=/absolute/path/to/laopo-sticker-mcp
STICKERS_FILE=stickers.json
MEDIA_DIR=media

# Keep both false on an unauthenticated public endpoint.
# They are intended for Secure MCP Tunnel or an authenticated deployment.
ENABLE_ADD_TOOL=false
ENABLE_COLLECT_TOOL=false

# Attachment collection limits.
MAX_UPLOAD_BYTES=10485760

# Server settings.
HOST=0.0.0.0
PORT=8000
MCP_STATELESS_HTTP=true
LOG_LEVEL=info
